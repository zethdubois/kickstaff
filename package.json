{
  "name": "publicweb",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node build/index.js",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "env:vanity": "node scripts/print-vanity-env.mjs",
    "db:up": "bash scripts/compose.sh up -d",
    "db:down": "bash scripts/compose.sh down",
    "db:status": "tsx scripts/db-status.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/drizzle-migrate.ts",
    "db:migrate:status": "tsx scripts/migrate-status.ts",
    "kickdesk:publish-manifest": "tsx scripts/publish-kickdesk-manifest.ts",
    "db:migrate:prod": "tsx scripts/drizzle-migrate.ts prod",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "list:users": "tsx scripts/list-users.ts",
    "test": "tsx --test src/lib/server/migrationStatus.test.ts src/lib/server/devDbApi.test.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.0.0",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.0",
    "drizzle-kit": "^0.31.10",
    "svelte": "^5.54.0",
    "svelte-check": "^4.4.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.45.2",
    "kickagent": "link:../kickagent",
    "nodemailer": "^8.0.4",
    "pg": "^8.20.0"
  }
}
