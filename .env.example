# =============================================================================
# Copy to `.env` and fill in values. Never commit `.env` (it is gitignored).
# =============================================================================

# --- Database (required for login, sessions, rental links) --------------------
# Local: postgresql://USER:PASSWORD@localhost:5432/DBNAME
# Railway: use the service’s DATABASE_URL (or DATABASE_PUBLIC_URL when developing locally).
# After a new DB: `pnpm db:migrate`
DATABASE_URL=

# --- Admin seed only (`pnpm seed:admin`) ------------------------------------
# Creates the user if missing. ADMIN_PASSWORD is not read at runtime.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Mail --------------------------------------------------------------------
# MAIL_DEV_ONLY=true → no SMTP; messages are logged to the server console only.
MAIL_DEV_ONLY=false

# Rental “Contact us” recipient. If empty, the app uses a built-in default (see
# `src/routes/api/rental-contact/+server.ts`). Set explicitly in production.
CONTACT_INBOX=kick.asset.management@gmail.com

# SMTP: required for real sends when MAIL_DEV_ONLY is false.
# From header: SMTP_USER is preferred, then ADMIN_EMAIL (see `src/lib/server/mail.ts`).
#
# Google Workspace / Gmail: create an App Password on the *same* account as SMTP_USER
# (Security → 2-Step Verification → App passwords). Use the 16-character value with
# no spaces in SMTP_PASSWORD.
#
# Typical Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# SMTP_SECURE=

# --- Public URLs -------------------------------------------------------------
# Optional; used in some emails (e.g. login links). Defaults to relative paths if unset.
# PUBLIC_BASE_URL=https://yourdomain.com

# Vanity hosts: city rental pages at `https://<host>/` while the path stays `/`.
# Use PUBLIC_ prefix (available during SSR and in the browser).
#
# Local: *.localhost resolves to loopback (RFC 6761), e.g. moscow.localhost
#   PUBLIC_VANITY_HOST_MOS=moscow.localhost
# Check: `pnpm run env:vanity`
#
# PUBLIC_VANITY_HOST_CDA=
# PUBLIC_VANITY_HOST_MOS=
# PUBLIC_VANITY_HOST_SPT=

# --- Misc --------------------------------------------------------------------
# AppFolio / rental tile URLs live in Postgres (`rental_landing_links`), edited at
# `/admin/rental-links` — not here.
#
# Debug: `pnpm list:users` — lists users in the DB pointed to by DATABASE_URL.
