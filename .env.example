# =============================================================================
# Copy to `.env` and fill in values. Never commit `.env` (it is gitignored).
# =============================================================================

# Vanity hosts: `https://<host>/` serves the same route as /cda, /mos, or /spt (URL bar stays `/`).
# Use PUBLIC_ prefix so routing works during SSR and client navigations.
#
# Local: *.localhost resolves to loopback (RFC 6761). Check: `pnpm run env:vanity`
PUBLIC_VANITY_HOST_CDA=coeurdalene.localhost
PUBLIC_VANITY_HOST_MOS=moscow.localhost
PUBLIC_VANITY_HOST_SPT=sandpoint.localhost

# --- Database (required for login, sessions, rental links, bills, units) -----
# Local: postgresql://USER:PASSWORD@localhost:5432/DBNAME
# Railway: use the service’s DATABASE_URL (or DATABASE_PUBLIC_URL when developing locally).
# After a new DB: `pnpm db:migrate`
# Debug: `pnpm list:users` — lists users in the DB pointed to by DATABASE_URL.
DATABASE_URL=postgresql://postgres:****@hopper.proxy.rlwy.net:11993/railway

# --- Admin seed only (`pnpm seed:admin`) ------------------------------------
# Creates the user if missing. ADMIN_PASSWORD is not read at runtime.
ADMIN_EMAIL=zeth@kickassetmanagement.com
ADMIN_PASSWORD=****

# --- Agent impersonation (dev only) -----------------------------------------
# Non-production: set AGENT_EMAIL, visit `http://localhost:5000/?as_agent=1`
# (see README). AGENT_PASSWORD is optional; not read by the running app today.
AGENT_EMAIL=agent@example.com
AGENT_PASSWORD=****

# --- Mail --------------------------------------------------------------------
# false = attempt real SMTP for contact form + admin mail. true = log only (safe for local dev).
MAIL_DEV_ONLY=false

# Rental “Contact us” deliveries (defaults in code to kick.asset.management@gmail.com if unset).
CONTACT_INBOX=kick.asset.management@gmail.com
# CONTACT_INBOX=zeth@pm.me
# CONTACT_INBOX=zeth@kickassetmanagement.com

# Outgoing mail. From header uses SMTP_USER first (then ADMIN_EMAIL). App password: 16 chars, no spaces.
# Gmail: use an App Password on the Google account you use for SMTP_USER. Proton: use Proton Bridge SMTP token for SMTP_USER account.
# SMTP_SECURE: omit to auto-use secure=true on port 465, false otherwise. Set true/false to override.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=zeth@kickassetmanagement.com
SMTP_PASSWORD=****

# Absolute site URL for links inside emails (e.g. https://yourdomain.com). Optional; defaults to relative /login if unset.
# Dev server runs on port 5000 (`vite.config.ts`); set PUBLIC_BASE_URL to match when testing email links locally.
PUBLIC_BASE_URL=http://localhost:5000

# --- Utility bill storage (server-only) --------------------------------------
# S3-compatible endpoint for utility-bill artifacts (Tigris example shown).
# AppFolio / rental tile URLs live in Postgres (`rental_landing_links`), edited at `/admin/rental-links` — not here.
UTILITY_BILL_S3_ENDPOINT=https://t3.storageapi.dev
UTILITY_BILL_S3_REGION=auto
UTILITY_BILL_S3_ACCESS_KEY_ID=****
UTILITY_BILL_S3_SECRET_ACCESS_KEY=****
UTILITY_BILL_S3_BUCKET=modular-safe-xrmah3foplbd

# --- Kickagent Phase 2 (optional) ---------------------------------------------
# Dynamic plugin from published manifest. Local kickagent:
#   node dist/cli.js serve-publish --dir publish --port 7099
# Leave unset to use Phase 1 npm wiring (`registerKickagentHelloCommand` only).
PUBLIC_KICKAGENT_MANIFEST_URL=http://127.0.0.1:7099/manifest.json
