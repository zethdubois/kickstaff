# PostgreSQL (users + sessions). Required for login on the main host.
#
# Local Docker/host:
#   postgresql://USER:PASSWORD@localhost:5432/DBNAME
#
# Railway: pick the URL for where the code runs.
# - Deployed app on Railway: DATABASE_URL (private / *.railway.internal) is typical.
# - pnpm dev on your laptop: copy DATABASE_PUBLIC_URL from the Postgres service variables
#   into your local .env as DATABASE_URL (same key the app reads). Do not use the private host locally.
# Locally, paste from Railway’s DATABASE_PUBLIC_URL.
# After pointing at a new/empty database, apply schema once: pnpm db:migrate
DATABASE_URL=

# First admin (run once): pnpm seed:admin — only creates the user if that email does not exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Debug login: pnpm list:users — prints emails in the DB pointed to by DATABASE_URL.

# Vanity hosts: `https://<host>/` serves the same route as /cda, /mos, or /spt (URL bar stays `/`).
# Use PUBLIC_ prefix so routing works during SSR and client navigations.
#
# Local dev without editing /etc/hosts: use a *.localhost name (RFC 6761 resolves to loopback).
# Example: PUBLIC_VANITY_HOST_MOS=moscow.localhost  →  open http://moscow.localhost:5173/
# Check vars: pnpm run env:vanity
#
# PRoduction server hostnames: (TBD)
# PUBLIC_VANITY_HOST_CDA=coeurdalene.example.com
# PUBLIC_VANITY_HOST_MOS=moscow.example.com
# PUBLIC_VANITY_HOST_SPT=sandpoint.example.com

# AppFolio deep links for city landing pages (/cda, /mos, /spt). Open
# https://kickasset.appfolio.com/listings, set filters (city, lease term, etc.),
# copy the URL from the address bar. If a variable is unset or empty, that tile
# is shown disabled (not clickable).
# PUBLIC_APPFOLIO_CDA_SHORT_TERM_URL=
# PUBLIC_APPFOLIO_CDA_LONG_TERM_URL=
# PUBLIC_APPFOLIO_CDA_APPLY_URL=
# PUBLIC_APPFOLIO_CDA_CONTACT_URL=
# PUBLIC_APPFOLIO_MOS_SHORT_TERM_URL=
# PUBLIC_APPFOLIO_MOS_LONG_TERM_URL=
# PUBLIC_APPFOLIO_MOS_APPLY_URL=
# PUBLIC_APPFOLIO_MOS_CONTACT_URL=
# PUBLIC_APPFOLIO_SPT_SHORT_TERM_URL=
# PUBLIC_APPFOLIO_SPT_LONG_TERM_URL=
# PUBLIC_APPFOLIO_SPT_APPLY_URL=
# PUBLIC_APPFOLIO_SPT_CONTACT_URL=
