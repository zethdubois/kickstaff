# =============================================================================
# Copy to `.env` and fill in values. Never commit `.env` (it is gitignored).
# Contract: ../kickagent/docs/kickagent/architecture/frontend-guide.md
# =============================================================================

# Vanity hosts: `https://<host>/` serves the same route as /cda, /mos, or /spt (URL bar stays `/`).
# Use PUBLIC_ prefix so routing works during SSR and client navigations.
#
# Local: *.localhost resolves to loopback (RFC 6761). Check: `pnpm run env:vanity`
PUBLIC_VANITY_HOST_CDA=coeurdalene.localhost
PUBLIC_VANITY_HOST_MOS=moscow.localhost
PUBLIC_VANITY_HOST_SPT=sandpoint.localhost

# =============================================================================
# PRODUCT DATABASE — these env names ARE the product database URLs
#
#   DATABASE_URL_DEV      laptop product DB (users, sessions, dataset config rows)
#   DATABASE_URL          this Kickstaff service's product DB (Railway staging or prod)
#   DATABASE_URL_STAGING  optional laptop-only seed / legacy target (see below)
#
# There is no PRODUCT_DATABASE_URL and no core_db variable. Use the names above.
#
# Ops databases (sites, units, gl, …) do NOT get env vars.
# Their URLs live as rows in the product database (admin form / SQL).
# Who may use which ops row: admin = all enabled rows on this deploy;
# other users = per-user subscription grants (SQL is enough; no dashboard required).
# Details: ../kickagent/docs/kickagent/architecture/host-ops-database.md
#
# Do not write: DATABASE_URL || DATABASE_URL_DEV
# Local default target: dev when DATABASE_URL_DEV is set.
# Railway badge: RAILWAY_ENVIRONMENT_NAME. See docs/guides/database-targeting.md
# =============================================================================

# Laptop product database (`pnpm db:up` → host port 5043). Required for local work.
DATABASE_URL_DEV=postgresql://postgres:postgres@localhost:5043/kickstaff_dev

# This deploy's product database. Set on Railway (staging service → staging Postgres;
# production service → production Postgres). On a laptop leave unset unless you need
# `db use prod` / migrate against prod — then paste that service's URL (secret).
# DATABASE_URL=

# Optional laptop-only: seed / reach a staging product target before dataset rows exist.
# On Railway staging, leave unset — that service uses DATABASE_URL above.
# DATABASE_URL_STAGING=

# Until the dataset settings form ships, a one-time seed may copy:
#   ops row "dev"     ← DATABASE_URL_DEV
#   ops row "staging" ← DATABASE_URL_STAGING
#   ops row "prod"    ← DATABASE_URL
# After seed, those ops URLs are table rows. Editing a row does not rewrite env.
#
# After a new local DB: `pnpm db:up` then `pnpm db:migrate` · `pnpm list:users`
# Staging from laptop: `pnpm db:migrate --db staging` · `pnpm seed:admin --db staging`

# --- Admin seed (`pnpm seed:admin`) + SUPER identity ----------------------
# Seed creates ADMIN_EMAIL as role=admin with a random temporary password
# (printed once; emailed if SMTP is configured). Use --db staging|prod as needed.
# SUPER (db use, badge): email === ADMIN_EMAIL. Self-serve: /forgot-password.
# Runtime (non-production only): ADMIN_PASSWORD or DEV_ADMIN_BYPASS_PASSWORD
# lets any admin sign in when the stored hash does not match (local recovery).
# Ignored when NODE_ENV=production. Prefer Forgot password over long-lived ADMIN_PASSWORD.
ADMIN_EMAIL=zeth@kickassetmanagement.com
# Optional local bypass / `pnpm reset:admin-password` override (not required for seed):
# ADMIN_PASSWORD=****
# Optional override for bypass only (else ADMIN_PASSWORD is used in dev):
# DEV_ADMIN_BYPASS_PASSWORD=****

# --- Agent impersonation (dev only) -----------------------------------------
# Non-production: set AGENT_EMAIL, visit `http://localhost:5000/?as_agent=1`
# (see README). AGENT_PASSWORD is optional; not read by the running app today.
AGENT_EMAIL=agent@example.com
AGENT_PASSWORD=****

# --- Mail --------------------------------------------------------------------
# false = attempt real SMTP for contact form + admin mail. true = log only (safe for local dev).
MAIL_DEV_ONLY=false

# Rental “Contact us” deliveries (defaults in code to kick.asset.management@gmail.com if unset).
CONTACT_INBOX=kick.asset.management@gmail.com
# CONTACT_INBOX=zeth@pm.me
# CONTACT_INBOX=zeth@kickassetmanagement.com

# Outgoing mail. From header uses SMTP_USER first (then ADMIN_EMAIL). App password: 16 chars, no spaces.
# Gmail: use an App Password on the Google account you use for SMTP_USER. Proton: use Proton Bridge SMTP token for SMTP_USER account.
# SMTP_SECURE: omit to auto-use secure=true on port 465, false otherwise. Set true/false to override.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=zeth@kickassetmanagement.com
SMTP_PASSWORD=****

# Absolute site URL for links inside emails (e.g. https://yourdomain.com). Optional; defaults to relative /login if unset.
# Dev server runs on port 5000 (`vite.config.ts`); set PUBLIC_BASE_URL to match when testing email links locally.
PUBLIC_BASE_URL=http://localhost:5000

# --- Kickagent (publisher link) -----------------------------------------------
# Browser loads manifest + ESM bundle from this URL (HTTPS in prod).
# Local: kickagent `pnpm serve-publish -- --dir publish --port 7099`
# Prod: https://<kickagent-host>/manifest.json (moduleUrl in manifest must be same origin)
# Leave unset for inline hello/foo only (no manifest server).
PUBLIC_KICKAGENT_MANIFEST_URL=http://127.0.0.1:7099/manifest.json
# Same secret as KICKAGENT_SERVICE_TOKEN on the matching kickagent environment.
# Unset on the laptop. Staging and production use different values.
# KICKAGENT_SERVICE_TOKEN=
# Optional. Defaults to the manifest origin. Used when this server calls
# POST /v1/commands/run instead of running the handler in-process.
# KICKAGENT_API_URL=https://<kickagent-host>
# Local dev with sibling checkout (CLI spawn instead of API):
# KICKAGENT_REPO=../kickagent
# KICKAGENT_USE_API=1   # force HTTP API even when CLI exists
